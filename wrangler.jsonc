{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cache-worker",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-18",
    "send_metrics": false,
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.33,
	},
	"vars": {
		"PRIVATE_COOKIE_NAMES": ["utdrprod-_session", "utdrprod-Token"],
		"PRIVATE_COOKIE_NAMES_DEV": ["utdrdev-_session", "utdrdev-Token"],
		"CLIENT_PREFS_COOKIE_NAME": "utdrprod-mwclientpreferences",
		"CLIENT_PREFS_COOKIE_NAME_DEV": "utdrdev-mwclientpreferences",
		"CLIENT_PREFS_CLASS_PREFIXES": [
			"skin-theme-clientpref-",
			"vector-feature-limited-width-clientpref-",
			"vector-feature-page-tools-pinned-clientpref-",
		],
		"PAGE_TTL": 86400,
		"MISSING_PAGE_TTL": 3600,
		"CACHED_NAMESPACES": [
			"",
			"Category",
			"Project",
			"File",
			"Undertale_Wiki",
			"Deltarune_Wiki",
			"Categoría",
			"Categor%C3%ADa",
			"Categoria",
			"Catégorie",
			"Cat%C3%A9gorie",
			"カテゴリ",
			"%E3%82%AB%E3%83%86%E3%82%B4%E3%83%AA",
			"Arquivo",
			"Archivo",
			"Fichier",
			"ファイル",
			"%E3%83%95%E3%82%A1%E3%82%A4%E3%83%AB",
			"Wiki_Undertale_FR",
		],
		"IS_DEV": false,
	},
	"env": {
		"dev": {
			"vars": {
				"PRIVATE_COOKIE_NAMES": [],
				"PRIVATE_COOKIE_NAMES_DEV": [],
				"CLIENT_PREFS_COOKIE_NAME": "",
				"CLIENT_PREFS_COOKIE_NAME_DEV": "",
				"CLIENT_PREFS_CLASS_PREFIXES": [],
				"PAGE_TTL": 86400,
				"MISSING_PAGE_TTL": 3600,
				"CACHED_NAMESPACES": [],
				"IS_DEV": true,
			},
			"secrets": {
				"required": [
					"BOT_QUERY_PARAM_ALLOWLIST",
					"BOT_QUERY_PARAM_BLOCKLIST",
					"BOT_SIGNING_KEY",
				]
			}
		},
	},
	"secrets": {
		"required": [
			"BOT_QUERY_PARAM_ALLOWLIST",
			"BOT_QUERY_PARAM_BLOCKLIST",
			"BOT_SIGNING_KEY",
		]
	},
}
